# Production Google OIDC. Keep real values in config/.env.local (gitignored).
XV12_AUTH_MODE=google
XV12_GOOGLE_CLIENT_ID=
XV12_GOOGLE_CLIENT_SECRET=
# For remote/PWA use, set this to the private HTTPS Tailscale Serve URL callback.
XV12_GOOGLE_REDIRECT_URI=http://127.0.0.1:8120/api/auth/google/callback
XV12_OWNER_GOOGLE_SUB=
XV12_COOKIE_SECURE=0

# QR onboarding / remote access.
# User-owned Tailscale API access token. XV12 uses it only to create/revoke user invites; never commit the real token.
XV12_TAILSCALE_API_TOKEN=
# '-' uses the API token's default tailnet.
XV12_TAILSCALE_TAILNET=-
# Private Tailscale Serve origin for Xoduz, for example https://omega.example.ts.net
XV12_PRIVATE_BASE_URL=
# Public bootstrap origin only, typically a dedicated Tailscale Funnel on port 8443, for example https://omega.example.ts.net:8443
XV12_PUBLIC_ONBOARDING_BASE_URL=
XV12_ONBOARDING_PORT=8122

# Optional independent data/service configuration.
XV12_ADAS_DATABASE_PATH=data/knowledge/adas_knowledge.sqlite
XV12_CALIBRATION_IQ_BASE_URL=http://127.0.0.1:8084/api/v1/tools/v1/calibration-iq
XV12_CALIBRATION_IQ_PROJECT_PATH=X:\calibration iq
XV12_WEB_TIMEOUT_SECONDS=20

# Optional standalone ComfyUI image runtime. XV12 owns it only when its launcher starts it.
XV12_COMFYUI_ENABLED=1
XV12_COMFYUI_ROOT=X:\AI_Runtimes\ComfyUI_windows_portable
XV12_COMFYUI_PORT=8188
XV12_COMFYUI_BASE_URL=http://127.0.0.1:8188
XV12_COMFYUI_CHECKPOINT=Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors
XV12_COMFYUI_DEFAULT_WIDTH=1024
XV12_COMFYUI_DEFAULT_HEIGHT=1024
XV12_COMFYUI_TIMEOUT_SECONDS=300
XV12_COMFYUI_OUTPUT_PATH=data/capabilities/creator/media/comfyui
